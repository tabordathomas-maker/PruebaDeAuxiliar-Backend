# Plantilla sin secretos: `invoke env` crea el .env (ignorado por git) a partir de ella.
# Las variables vacías son obligatorias y `invoke env` las genera al azar.
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=
POSTGRES_DB=biblioteca
# Si se deja vacía, `invoke env` la arma con las tres variables anteriores.
DATABASE_URL=
JWT_SECRET=
LIBRARIAN_PASSWORD=
ADMIN_PASSWORD=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
LOAN_DAYS=14
LIBRARIAN_NAME=Laura Gómez
LIBRARIAN_EMAIL=bibliotecario@example.com
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
